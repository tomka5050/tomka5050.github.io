rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny: sem nyilvános olvasás, sem listázás.
    match /{document=**} { allow read, write: if false; }

    match /attempts/{attemptId} {
      // Csak egyszeri létrehozás; kitöltők nem olvashatják mások válaszait.
      allow create: if request.auth != null
        && request.auth.token.firebase.sign_in_provider == "anonymous"
        && request.resource.data.keys().hasOnly([
          "testId","schemaVersion","attemptId","studentCode","userUid",
          "startedAt","submittedAt","durationSeconds","answers","consentVersion"
        ])
        && request.resource.data.keys().hasAll([
          "testId","schemaVersion","attemptId","studentCode","userUid",
          "startedAt","submittedAt","durationSeconds","answers","consentVersion"
        ])
        && request.resource.data.testId == "BIO-DIAG-001"
        && request.resource.data.schemaVersion == 1
        && request.resource.data.consentVersion == "v1"
        && request.resource.data.attemptId == attemptId
        && request.resource.data.userUid == request.auth.uid
        && request.resource.data.studentCode is string
        && request.resource.data.studentCode.size() >= 8
        && request.resource.data.studentCode.size() <= 40
        && request.resource.data.startedAt is timestamp
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds >= 0
        && request.resource.data.durationSeconds <= 604800
        && request.resource.data.answers is list
        && request.resource.data.answers.size() == 40;
      allow get, list, update, delete: if false;
    }
  }
}
